<?xml version="1.0" encoding="utf-8"?>
<!-- The window shown while the process starts, before Flutter's first frame.
     Transparent rather than a colour, so the wallpaper LaunchTheme asks for is
     what shows during startup. A colour here would cover it, and the launcher
     would open on a flat rectangle that turns into the wallpaper a moment
     later — the cold start looking like the launcher waking up, which is the
     thing this file was added to avoid in the first place. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/transparent" />
</layer-list>
